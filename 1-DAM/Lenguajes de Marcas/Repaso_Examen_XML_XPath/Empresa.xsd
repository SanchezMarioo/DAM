<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="edad">
    <xs:simpleContent>  
      <xs:restriction base="xs:int">
        <xs:minInclusive value="18"/>
        <xs:maxInclusive value="65"/>
      </xs:restriction>
    </xs:simpleContent>
  </xs:element>
  <xs:element name="departamento">
    <xs:simpleContent>
      <xs:restriction base="xs:string">
        <xs:enumeration value="Ventas" />
        <xs:enumeration value="IT" />
        <xs:enumeration value="RRHH" /> 
      </xs:restriction>
    </xs:simpleContent>
  </xs:element>
  

  <xs:element name="empresa">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="empleado" type="TipoEmpleado" maxOccurs="unbonded"/>
      </xs:sequence>

    </xs:complexType>
  </xs:element>
  
  <xs:complexType name="TipoEmpleado">
    <xs:sequence>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element ref="edad"/>
      <xs:element ref="departamento" />
      <xs:element ref="salario"/>
      <xs:element ref="salario" />
    </xs:sequence>
    <xs:attribute name="id" type="xs:int" use="required"/>
  </xs:complexType>
  
  
  <xs:element name="nombre" type="xs:string"/>

  

  <xs:element name="salario" type="xs:decimal"> 
  <xs:simpleContent>
    <xs:fractionDigits value="2" />
  </xs:simpleContent>
    <xs:complexType>
      <xs:attribute name="moneda" type="xs:decimal" use="required" />
    </xs:complexType>
  </xs:element>
  
   
</xs:schema>
