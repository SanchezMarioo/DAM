<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

<xs:element name="nombre" type="xs:string" />
<xs:element name="categoria" type="xs:string">
  <xs:simpleContent>
    <xs:extension type="xs:string">
      <xs:restriction>
          <xs:enumeration type="Informatica"  />
          <xs:enumeration type="Electronica" />
          <xs:enumeration type="Oficina" />
      </xs:restriction>
    </xs:extension>
  </xs:simpleContent>
</xs:element>

<xs:element name="precio" type="xs:decimal">
<xs:complexType>
<xs:simpleType>
  <xs:attribute name="moneda" type="xs:string">
    <xs:simpleType>
      <xs:extension type="xs:string">
        <xs:restriction>
          <xs:enumeration type="EUR" />
          <xs:enumeration type="USD" />
        </xs:restriction>
      </xs:extension>
    </xs:simpleType>
  </xs:attribute>
</xs:simpleType>
  <xs:simpleContent>
    <xs:extension type="xs:decimal">
      <xs:restriction>
        <xs:fractionDigits value="2" />
      </xs:restriction>
    </xs:extension>
  </xs:simpleContent>
  </xs:complexType>
</xs:element>


<xs:element name="stock" type="xs:int">
  <xs:simpleContent>
    <xs:extension type="xs:int">
      <xs:restriction>
        <xs:minInclusive value="0" />
        <xs:maxInclusive value="200" />
      </xs:restriction>
    </xs:extension>
  </xs:simpleContent>
</xs:element>

  <xs:element name="producto" type="xs:string">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="nombre" />
        <xs:element ref="categoria" />
        <xs:element ref="precio" />
        <xs:element ref="stock" />  
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required" />
    </xs:complexType>
  </xs:element>
</xs:schema>
